{
  "app-id": "com.github.fabiocolacio.marker",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "marker",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=cups",
    "--filesystem=home"
  ],
  "cleanup": ["/include", "/lib/pkgconfig",
    "/share/pkgconfig", "/share/aclocal",
    "/man", "/share/man", "/share/gtk-doc",
    "/share/vala",
    "*.la", "*.a"],
    "modules": [
      {
        "name": "libspelling",
        "buildsystem": "meson",
        "config-opts": [
          "--libdir=lib",
          "-Ddocs=false",
          "-Dintrospection=disabled",
          "-Dvapi=false",
          "-Dsysprof=false"
        ],
        "sources": [
          {
            "type": "git",
            "url": "https://gitlab.gnome.org/GNOME/libspelling.git",
            "commit": "1facdde8e1c0fd72bed806f9a9be2fbec83af5f2"
          }
        ]
      },
      {
        "name": "Marker",
        "buildsystem": "meson",
        "config-opts": ["--libdir=lib"],
        "post-install": [
            "for size in 64 128; do rsvg-convert -w $size -h $size -f png -o $size.png /app/share/icons/hicolor/scalable/apps/com.github.fabiocolacio.marker.svg; install -Dm644 $size.png /app/share/icons/hicolor/${size}x${size}/apps/com.github.fabiocolacio.marker.png; done"
        ],
        "sources": [
          {
            "type": "dir",
            "path": ".",
            "skip": [".git", ".flatpak-builder", "build", "build-*", "_build", "subprojects/libspelling"]
          }
        ]
      }
    ]
}
